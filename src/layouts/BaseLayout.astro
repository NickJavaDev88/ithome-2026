---
import '../styles/global.css';
import { loadProjectConfigSync } from '../../scripts/ithome/config.mjs';

interface Props {
  title?: string;
  description?: string;
}

const project = loadProjectConfigSync();
const { title = project.seriesTitle, description = `${project.seriesTitle}：30 天系列文章` } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const rssUrl = new URL(`${import.meta.env.BASE_URL}rss.xml`, Astro.site);
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={rssUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('ithome-2026:theme');
          const theme = savedTheme === 'light' || savedTheme === 'dark'
            ? savedTheme
            : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <button class="theme-toggle" type="button" aria-label="切換為暗色佈景主題" aria-pressed="false">
      <span class="theme-toggle__icon" aria-hidden="true">
        <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1"></path>
        </svg>
        <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24">
          <path d="M20 15.2A8.5 8.5 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"></path>
        </svg>
      </span>
    </button>
    <header class="site-header">
      <a class="brand" href={import.meta.env.BASE_URL}>{project.seriesTitle}</a>
      <span>iThome 鐵人賽 30 天連載</span>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>30 天連載 · Markdown / Astro / GitHub Pages</span>
    </footer>
    <script is:inline>
      (() => {
        const button = document.querySelector('.theme-toggle');
        if (!(button instanceof HTMLButtonElement)) return;

        const syncButton = () => {
          const isDark = document.documentElement.dataset.theme === 'dark';
          button.setAttribute('aria-pressed', String(isDark));
          button.setAttribute('aria-label', `切換為${isDark ? '亮色' : '暗色'}佈景主題`);
        };

        button.addEventListener('click', () => {
          const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = nextTheme;
          try { localStorage.setItem('ithome-2026:theme', nextTheme); } catch (_) {}
          syncButton();
        });

        syncButton();
      })();
    </script>
  </body>
</html>

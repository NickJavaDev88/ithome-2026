---
import { loadProjectConfigSync } from '../../scripts/ithome/config.mjs';
const base = import.meta.env.BASE_URL;
const { brand } = loadProjectConfigSync();
---
<span class="series-mark" role="img" aria-label={brand.mark.alt}>
  <img class="series-mark__image series-mark__image--light" src={`${base}${brand.mark.light}`} alt="" width="1012" height="1012" />
  <img class="series-mark__image series-mark__image--dark" src={`${base}${brand.mark.dark}`} alt="" width="1012" height="1012" />
</span>

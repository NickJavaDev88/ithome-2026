---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostLayout from '../layouts/PostLayout.astro';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const current = posts.at(-1);
let Content;

if (current) {
  const rendered = await current.render();
  Content = rendered.Content;
}

const previous = current && posts.length > 1 ? posts.at(-2) : undefined;
---
{current && Content ? (
  <PostLayout post={current} previous={previous}>
    <Content />
  </PostLayout>
) : (
  <BaseLayout>
    <section class="empty-home">
      <p class="eyebrow">2026 iThome 鐵人賽 · Software Development</p>
      <h1>AI 都會寫程式了，我還要學什麼？</h1>
      <p>連載尚未開始。文章會依排程逐日公開。</p>
    </section>
  </BaseLayout>
)}
